# ==============================================================================
# TRON (AUTONOMA) - APPLICATION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and populate your credentials.
# Never commit .env or real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Deployment
# ------------------------------------------------------------------------------
# Listening port for local development and container deployments (default: 8080)
PORT=8080

# Public or internal base URL of the deployed API service
# Used by frontend dashboard and health checks (alias: ECHOMIND_API_BASE_URL)
API_BASE_URL=https://echomind-ltwo.onrender.com

# Allowed CORS origins (comma-separated or JSON list, never '*' with allow_credentials=True)
# Defaults to same-origin / localhost dev origins
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000

# Admin API Key for authenticated manual triggers (POST /api/agent/cycle, POST /api/agent/close-window)
# Passed in requests via the 'X-Admin-Key' HTTP header. Leave blank to disable auth check in development.
ADMIN_API_KEY=

# ------------------------------------------------------------------------------
# Primary LLM Provider: Google Gemini
# ------------------------------------------------------------------------------
# Google AI Studio / Gemini API Key (Required for live generation and search grounding)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model used for candidate evaluation, search extraction, and post synthesis
# Defaults to gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# Secondary LLM Provider: Groq (Automated Failover)
# ------------------------------------------------------------------------------
# Groq Cloud API Key (Required for high-speed fallback when Gemini encounters rate limits or errors)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=

# Fast open-weights model for Groq fallback inference
# Defaults to llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Provider Selection Strategy
# ------------------------------------------------------------------------------
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq

# ------------------------------------------------------------------------------
# Autonomous Agent & Publishing Cadence
# ------------------------------------------------------------------------------
# Maximum concurrent autonomous personas (default: 5)
# When exceeded, oldest agent and associated records are atomically evicted via FIFO rotation
MAX_AGENTS=5

# Interval in minutes between live topic discovery loops (default: 45 min)
# Alias: AGENT_INTERVAL_MINUTES
DISCOVERY_INTERVAL_MINUTES=45

# Randomized offset in seconds added to discovery cycles (default: 300s = ±5 min)
# Prevents API request spiking and produces natural publishing timing
DISCOVERY_JITTER_SECONDS=300

# Length of publishing window in minutes (default: 45 min)
# At the end of each window, the top qualifying candidate story is selected and published
PUBLISH_WINDOW_MINUTES=45

# Minimum deterministic quality score (0.0 to 100.0) required for story eligibility
# Candidates scoring below this threshold are rejected (status: REJECTED)
MIN_NEWS_SCORE=75.0

# ------------------------------------------------------------------------------
# Storage & Persistence (SQLite WAL Mode)
# ------------------------------------------------------------------------------
# Path to local SQLite database file (default: agent_memory.db or /app/data/tron.db in container)
DATABASE_PATH=agent_memory.db
AGENT_DB_PATH=agent_memory.db

# Database connection URL (standard SQLite format)
DATABASE_URL=sqlite:///agent_memory.db

# ------------------------------------------------------------------------------
# Observability, Logging & Rate Limiting (Phase 1 Production)
# ------------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# Emits structured JSON with ISO-8601 UTC timestamps, request_id, and automated secret redaction.
LOG_LEVEL=INFO

# In-memory sliding-window rate limit ceilings (requests per client IP per 60-second window)
# POST /api/agent/init   : 5 req/min (anti-registration flood)
# POST /api/agent/cycle  : 3 req/min (anti-quota drain)
# GET  /api/agent/*      : 120 req/min (high-throughput read & polling ceiling)
RATE_LIMIT_INIT_PER_MINUTE=5
RATE_LIMIT_CYCLE_PER_MINUTE=3
RATE_LIMIT_READ_PER_MINUTE=120

# ------------------------------------------------------------------------------
# Legacy / Media Models (Optional Reference)
# ------------------------------------------------------------------------------
# Legacy image generation model identifier
IMAGE_MODEL=imagen-3.0-generate-002

# NOTE: Legacy documentation references OPENROUTER_API_KEY and X_API_* keys.
# The active Tron runtime operates exclusively via Gemini Primary (with search grounding),
# Groq Fallback, and arXiv live research retrieval. OpenRouter is not used by the current codebase.
# OPENROUTER_API_KEY=
