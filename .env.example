# ==============================================================================
# TRON / AUTONOMA ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your API keys before running.
# ==============================================================================

# Primary LLM & Live Web Search Grounding (Get free key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Fallback LLM Provider (Get free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Provider Preference (default: primary=gemini, fallback=groq)
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq

# Server & Storage
PORT=8080

# Turso Cloud Database (Optional: provides permanent cloud memory across restarts)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

AGENT_DB_PATH=agent_memory.db
DATABASE_URL=sqlite:///agent_memory.db

# Agent & Editorial Scheduling
DISCOVERY_INTERVAL_MINUTES=45
DISCOVERY_JITTER_SECONDS=300
PUBLISH_WINDOW_MINUTES=45
MIN_NEWS_SCORE=75.0
MAX_AGENTS=5

# Optional Admin Secret Key (for manual testing triggers)
ADMIN_API_KEY=

# Security & Production Hygiene
ENABLE_DOCS=false
CORS_ORIGINS=*
MUTATION_RATE_LIMIT_PER_MINUTE=30

# Central API Base URL
API_BASE_URL=https://echomind-ltwo.onrender.com
